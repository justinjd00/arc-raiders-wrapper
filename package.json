{
  "name": "@justinjd00/arc-raiders-api",
  "version": "2.0.1",
  "description": "Zero-dependency, type-safe TypeScript client for the MetaForge ARC Raiders API. Items, weapons, quests, ARCs, traders, Ermal, live events and map markers, plus quest chains, item usage, fuzzy search, React hooks and a CLI.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "arc-raiders": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "CONTRACT=1 vitest run",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run build",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinjd00/arc-raiders-wrapper.git"
  },
  "homepage": "https://github.com/justinjd00/arc-raiders-wrapper#readme",
  "bugs": {
    "url": "https://github.com/justinjd00/arc-raiders-wrapper/issues"
  },
  "funding": "https://github.com/sponsors/justinjd00",
  "keywords": [
    "arc-raiders",
    "arc raiders",
    "embark-studios",
    "metaforge",
    "game-api",
    "api-client",
    "sdk",
    "typescript",
    "react-hooks",
    "cli",
    "quests",
    "loot"
  ],
  "author": "Justin Dewitz (https://github.com/justinjd00)",
  "license": "MIT",
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
